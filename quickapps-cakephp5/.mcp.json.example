{
  "mcpServers": {
    "phpunit": {
      "type": "stdio",
      "command": "/usr/local/bin/docker",
      "args": [
        "exec",
        "-i",
        "quickapps5-web",
        "php",
        "vendor/bin/mcp-phpunit-server"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_KEY"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}